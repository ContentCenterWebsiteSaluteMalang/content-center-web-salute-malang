# Isi nilai-nilai ini di Vercel: Settings -> Environment Variables
# (Production, Preview, dan Development)

# Dibaca di browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Dibaca di sisi server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Wajib di Vercel agar hasil build memakai target Vercel
NITRO_PRESET=vercel
